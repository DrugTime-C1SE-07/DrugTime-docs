  "item": [
    {
      "name": "Mobile - Email OTP",
      "item": [
        {
          "name": "1. Request OTP (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/mobile/otp",
              "path": [
                "auth",
                "mobile",
                "otp"
              ]
            },
            "description": "Expected: 204. Open Mailpit at {{mailpit_url}} and copy the newest code into collection variable otp."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP request accepted (204)', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify OTP (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"token\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/mobile/verify",
              "path": [
                "auth",
                "mobile",
                "verify"
              ]
            },
            "description": "Expected: 200. Ensure email is exactly the address used for request OTP and otp is from the latest email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verified (200)', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.collectionVariables.set('mobile_access_token', body.session.access_token); pm.collectionVariables.set('mobile_user_id', body.user_id); }",
                  "if (pm.response.code === 200) { pm.environment.set('mobile_access_token', pm.response.json().session.access_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
