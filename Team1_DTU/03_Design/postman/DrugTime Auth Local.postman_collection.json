    {
      "name": "Admin - Password Login",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/login",
              "path": [
                "auth",
                "admin",
                "login"
              ]
            },
            "description": "Requires an existing local admin account. Expected: 200; wrong credentials: 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login returns success or expected auth failure', function () { pm.expect([200, 401]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('admin_access_token', pm.response.json().session.access_token); }",
                  "if (pm.response.code === 200) { pm.environment.set('admin_access_token', pm.response.json().session.access_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
